{
  "name": "dsh-opencodeconnect-nokey",
  "version": "0.1.0",
  "description": "把 OpenCode 内置的免费模型（deepseek-v4.1-flash-free / big-pickle / glm-5.3-flash-free 等）接入 DSH，无需任何 API Key。通过驱动本机 opencode-cli 完成真实推理，DSH 侧只看到标准 OpenAI 兼容端点。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "free-model",
    "no-api-key",
    "openai-compatible"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Sakura721/dsh-opencodeconnect-nokey.git"
  }
}
